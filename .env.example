# AgentGuard local development template.
# Run scripts/bootstrap-dev.ps1 instead of inventing credentials by hand.
# Every value below is a placeholder; never use this file as production config.

AGENTGUARD_ENVIRONMENT=development
POSTGRES_DB=agentguard_dev
POSTGRES_USER=agentguard_bootstrap
POSTGRES_PASSWORD=replace-with-a-random-local-password

AGENTGUARD_RUNTIME_USER=agentguard_runtime
AGENTGUARD_RUNTIME_PASSWORD=replace-with-a-random-local-password
AGENTGUARD_MIGRATION_USER=agentguard_migration
AGENTGUARD_MIGRATION_PASSWORD=replace-with-a-random-local-password
AGENTGUARD_RETENTION_USER=agentguard_retention
AGENTGUARD_RETENTION_PASSWORD=replace-with-a-random-local-password
AGENTGUARD_LEDGER_COMPACTOR_USER=agentguard_ledger_compactor
AGENTGUARD_LEDGER_COMPACTOR_PASSWORD=replace-with-a-random-local-password
AGENTGUARD_INTEGRITY_COMPACTOR_USER=agentguard_integrity_compactor
AGENTGUARD_INTEGRITY_COMPACTOR_PASSWORD=replace-with-a-random-local-password
AGENTGUARD_ARCHIVE_REPLICATION_USER=agentguard_replication_worker
AGENTGUARD_ARCHIVE_REPLICATION_PASSWORD=replace-with-a-random-local-password

# Compose reads these files and mounts them as container secrets.
AGENTGUARD_KEY_PEPPER_HOST_FILE=.dev-secrets/key_pepper
AGENTGUARD_INTEGRITY_KEY_HOST_FILE=.dev-secrets/integrity_key
AGENTGUARD_DATABASE_URL_HOST_FILE=.dev-secrets/database_url
AGENTGUARD_MIGRATION_DATABASE_URL_HOST_FILE=.dev-secrets/migration_database_url
AGENTGUARD_RETENTION_DATABASE_URL_HOST_FILE=.dev-secrets/retention_database_url
AGENTGUARD_ARCHIVE_ENCRYPTION_KEYS_HOST_FILE=.dev-secrets/archive_encryption_keys.json
AGENTGUARD_ARCHIVE_REPLICATION_DATABASE_URL_HOST_FILE=.dev-secrets/replication_database_url
AGENTGUARD_LEDGER_COMPACTOR_DATABASE_URL_HOST_FILE=.dev-secrets/ledger_compactor_database_url
AGENTGUARD_INTEGRITY_COMPACTOR_DATABASE_URL_HOST_FILE=.dev-secrets/integrity_compactor_database_url

# Safe local defaults.
AGENTGUARD_CAPTURE_CONTENT=false
AGENTGUARD_DASHBOARD_API_KEY_LOGIN_ENABLED=true
AGENTGUARD_OIDC_ENABLED=false
AGENTGUARD_ANCHOR_ENABLED=false
AGENTGUARD_ARCHIVE_ENABLED=false
AGENTGUARD_RETENTION_PURGE_ENABLED=false
AGENTGUARD_ARCHIVE_REPLICATION_ENABLED=false
AGENTGUARD_LEDGER_ARCHIVE_ENABLED=false
AGENTGUARD_LEDGER_COMPACTION_ENABLED=false
AGENTGUARD_INTEGRITY_SEGMENT_COMPACTION_ENABLED=false
AGENTGUARD_ALLOW_INSECURE_HTTP=false
AGENTGUARD_INGEST_URL=http://127.0.0.1:8000/v1/ingest

# Optional integrations are intentionally empty.
OPENAI_API_KEY=
